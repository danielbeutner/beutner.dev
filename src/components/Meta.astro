---
import { SITE } from '../config';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
}

const { title, description, image } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const metaTitle = title ?? SITE.title;
const metaDescription = description ?? SITE.description;
---

<!-- General -->
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={metaTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={SITE.locale} />
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
{image && <meta property="og:image" content={new URL(image, Astro.site)} />}

<!-- Manifest -->
<link rel="manifest" href="/site.webmanifest" />

<!-- RSS Feed -->
<link
  type="application/rss+xml"
  rel="alternate"
  href={`${SITE.url}/feed.xml`}
  title={SITE.title}
/>

<!-- Fonts -->
<link rel="preload" href="/assets/fonts/arbutus.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/assets/fonts/dankmono.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/assets/fonts/chunkfive.woff2" as="font" type="font/woff2" crossorigin />
