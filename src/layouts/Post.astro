---
import Base from './Base.astro';
import { formatDate, isoDate } from '../config';

interface Props {
  title: string;
  description?: string | undefined;
  pubDate: Date;
  entryId: string;
}

const { title, description, pubDate, entryId } = Astro.props;
---

<Base title={title} description={description}>
  <article
    id={entryId}
    role="article"
    itemscope
    itemtype="http://schema.org/BlogPosting"
    aria-labelledby={`${entryId}-title`}
  >
    <header>
      <h1 id={`${entryId}-title`} itemprop="headline">{title}</h1>
      <time itemprop="datePublished" datetime={isoDate(pubDate)}>
        {formatDate(pubDate)}
      </time>
    </header>
    <div itemprop="articleBody">
      <slot />
    </div>
  </article>
</Base>
