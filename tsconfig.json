{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", ".astro/types.d.ts", "astro.config.mjs", "postcss.config.mjs"],
  "exclude": ["dist", "node_modules"]
}
